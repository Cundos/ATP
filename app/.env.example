# ============================================================
# Atilio Plants — Environment Variables Example
# ============================================================
# Copy this file to .env.local (for local development) or
# configure the variables directly in your deployment platform.
# NEVER commit real secrets to version control.
# ============================================================

# ------------------------------------------------------------
# Database (Neon PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require

# ------------------------------------------------------------
# File Storage (Vercel Blob — required for Vercel deployments)
# ------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=CHANGE_ME

# Force local filesystem storage even on Vercel (not recommended for prod):
# STORAGE_DRIVER=local

# Local filesystem storage path (Docker / homelab only):
# STORAGE_LOCAL_PATH=/app/storage

# ------------------------------------------------------------
# Open Plantbook Integration (Milestone 3)
# ------------------------------------------------------------
# Obtain your credentials at: https://open.plantbook.io/apikey/
# These variables are server-side only — NEVER use NEXT_PUBLIC_ prefix.
OPEN_PLANTBOOK_CLIENT_ID=CHANGE_ME
OPEN_PLANTBOOK_CLIENT_SECRET=CHANGE_ME
