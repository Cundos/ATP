# Configuración de Entorno Local - Atilio Plants

# Puerto expuesto en localhost para PostgreSQL
POSTGRES_PORT=5432

# Credenciales de base de datos local
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=atilio_plants

# Cadena de conexión completa para la aplicación / Prisma
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@postgres:5432/atilio_plants?schema=public

# Puerto HTTP de la aplicación Next.js
APP_PORT=3000

# Ruta de almacenamiento local de fotografías (dentro del contenedor o host)
STORAGE_LOCAL_PATH=/app/storage/photos
