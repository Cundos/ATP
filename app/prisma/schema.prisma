datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum HealthStatus {
  UNKNOWN
  HEALTHY
  ATTENTION
  RECOVERY
}

enum LifecycleStatus {
  ACTIVE
  ARCHIVED
}

enum EventSource {
  HOME_ASSISTANT
  MANUAL
}

enum NativeStatus {
  NATIVE
  NON_NATIVE
  ENDEMIC
  INTRODUCED_NATURALIZED
}

enum PhenologyEventType {
  SPROUTING
  FLOWERING
  FRUITING
  SOWING
  PLANTING
}

enum SourceType {
  BOTANICAL_INSTITUTION
  GOVERNMENT_DATASET
  HERBARIUM
  SCIENTIFIC_PUBLICATION
  MANUAL_CURATION
}

model Location {
  id               String          @id // UUIDv7
  name             String
  lifecycle_status LifecycleStatus @default(ACTIVE)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  plants           Plant[]

  @@map("locations")
}

model PlantReference {
  id              String   @id // UUIDv7
  provider        String   // Ej: OPEN_PLANTBOOK
  external_id     String   // Identificador externo (ej: pid)
  scientific_name String
  common_names    Json?    // Lista de nombres comunes [String]
  reference_care  Json?    // Objeto JSON con rangos (luz, riego, temp, humedad)
  image_url       String?  // URL de imagen ilustrativa de catálogo
  fetched_at      DateTime @default(now())
  last_sync_at    DateTime @default(now())
  raw_data        Json     // Payload original devuelto por el proveedor

  plants          Plant[]
  regional_species RegionalPlantSpecies[]

  @@unique([provider, external_id], name: "provider_external_id_unique")
  @@map("plant_references")
}

model Plant {
  id               String                   @id // UUIDv7
  permanent_code   String                   @unique // Código secuencial permanente humano (AT-PL-XXX)
  common_name      String                   // Nombre común asignado (obligatorio)
  scientific_name  String?                  // Especie botánica (opcional)
  cultivar         String?                  // Variedad botánica (opcional)
  health_status    HealthStatus             @default(UNKNOWN)
  lifecycle_status LifecycleStatus          @default(ACTIVE)
  acquisition_date DateTime?                // Fecha de incorporación física (nullable para desconocida)
  notes            String?                  @db.Text
  location_id      String?
  reference_id     String?
  created_at       DateTime                 @default(now())
  updated_at       DateTime                 @updatedAt

  location         Location?                @relation(fields: [location_id], references: [id], onDelete: Restrict)
  reference        PlantReference?          @relation(fields: [reference_id], references: [id], onDelete: SetNull)
  photos           Photo[]
  profile          PlantCultivationProfile?
  ha_binding       PlantHomeAssistantBinding?
  events           PlantOperationalEvent[]

  @@index([location_id])
  @@index([reference_id])
  @@index([lifecycle_status])
  @@index([health_status])
  @@map("plants")
}

model PlantCultivationProfile {
  id               String   @id // UUIDv7
  plant_id         String   @unique
  pot_info         String?  // Tipo, material, tamaño de maceta
  substrate_info   String?  // Sustrato real colocado
  light_conditions String?  // Condiciones reales de luz
  watering_notes   String?  // Notas y observaciones sobre régimen de riego
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  plant            Plant    @relation(fields: [plant_id], references: [id], onDelete: Cascade)

  @@map("plant_cultivation_profiles")
}

model PlantHomeAssistantBinding {
  id                     String   @id // UUIDv7
  plant_id               String   @unique
  moisture_entity_id     String?
  battery_entity_id      String?
  online_entity_id       String?
  stale_entity_id        String?
  visual_state_entity_id String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  plant                  Plant    @relation(fields: [plant_id], references: [id], onDelete: Cascade)

  @@map("plant_ha_bindings")
}

model PlantOperationalEvent {
  id           String      @id // UUIDv7
  plant_id     String
  source       EventSource @default(HOME_ASSISTANT)
  event_type   String
  event_key    String      @unique
  occurred_at  DateTime
  received_at  DateTime    @default(now())
  value_number Float?
  value_text   String?
  unit         String?
  metadata     Json?
  created_at   DateTime    @default(now())

  plant        Plant       @relation(fields: [plant_id], references: [id], onDelete: Cascade)

  @@index([plant_id, occurred_at(sort: Desc)])
  @@map("plant_operational_events")
}

model Photo {
  id          String    @id // UUIDv7
  plant_id    String
  file_path   String    // Storage key: photos/{permanent_code}/{unique_file}.webp
  file_name   String    // Nombre original del archivo cargado
  mime_type   String    // Formato MIME (image/webp, etc.)
  file_size   Int?      // Tamaño en bytes
  is_primary  Boolean   @default(false)
  captured_at DateTime?
  taken_at    DateTime?
  caption     String?   @db.Text
  created_at  DateTime  @default(now())

  plant       Plant     @relation(fields: [plant_id], references: [id], onDelete: Cascade)

  @@index([plant_id])
  @@index([is_primary])
  @@map("photos")
}

model DataSource {
  id          String     @id // UUIDv7
  name        String
  type        SourceType
  url         String?
  description String?    @db.Text
  version     String?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  phenology_records PlantPhenology[]

  @@map("data_sources")
}

model EcologicalRegion {
  id          String   @id // UUIDv7
  code        String   @unique
  name        String
  biome       String
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  growing_regions   GrowingRegionEcologicalRegion[]
  regional_species  RegionalPlantSpecies[]
  phenology_records PlantPhenology[]

  @@map("ecological_regions")
}

model GrowingRegion {
  id          String   @id // UUIDv7
  code        String   @unique
  name        String
  country     String
  province    String
  locality    String?
  latitude    Float?
  longitude   Float?
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  ecological_regions GrowingRegionEcologicalRegion[]

  @@map("growing_regions")
}

model GrowingRegionEcologicalRegion {
  growing_region_id    String
  ecological_region_id String
  is_primary           Boolean  @default(false)
  notes                String?  @db.Text
  created_at           DateTime @default(now())

  growing_region    GrowingRegion    @relation(fields: [growing_region_id], references: [id], onDelete: Cascade)
  ecological_region EcologicalRegion @relation(fields: [ecological_region_id], references: [id], onDelete: Cascade)

  @@id([growing_region_id, ecological_region_id])
  @@index([ecological_region_id])
  @@map("growing_region_ecological_regions")
}

model RegionalPlantSpecies {
  id                   String           @id // UUIDv7
  scientific_name      String
  canonical_name       String?
  family               String?
  common_names         Json?            // Array de strings
  native_status        NativeStatus     @default(NATIVE)
  ecological_region_id String
  reference_id         String?
  growth_habit         String?          // arbol, arbusto, hierba, trepadora, etc.
  conservation_status  String?          // LC, VU, EN, etc.
  notes                String?          @db.Text
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  ecological_region EcologicalRegion @relation(fields: [ecological_region_id], references: [id], onDelete: Restrict)
  reference         PlantReference?  @relation(fields: [reference_id], references: [id], onDelete: SetNull)
  phenology_records PlantPhenology[]

  @@unique([scientific_name, ecological_region_id], name: "species_ecological_region_unique")
  @@index([ecological_region_id])
  @@index([native_status])
  @@index([reference_id])
  @@map("regional_plant_species")
}

model PlantPhenology {
  id                   String             @id // UUIDv7
  species_id           String
  ecological_region_id String
  event_type           PhenologyEventType
  month                Int                // 1 a 12
  source_id            String
  notes                String?            @db.Text
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt

  species           RegionalPlantSpecies @relation(fields: [species_id], references: [id], onDelete: Cascade)
  ecological_region EcologicalRegion     @relation(fields: [ecological_region_id], references: [id], onDelete: Cascade)
  source            DataSource           @relation(fields: [source_id], references: [id], onDelete: Restrict)

  @@unique([species_id, ecological_region_id, event_type, month, source_id], name: "phenology_event_unique")
  @@index([species_id])
  @@index([ecological_region_id, month])
  @@index([event_type, month])
  @@index([source_id])
  @@map("plant_phenologies")
}